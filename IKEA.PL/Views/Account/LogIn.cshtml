@model LogInVM
@{
    ViewData["Title"] = "LogIn";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}
<div class="main-agileinfo">
	<div class="agileits-top">
		<form asp-action="LogIn" method="post">
			<input class="text" style="margin-bottom:10px" type="email" asp-for="Email" placeholder="Email" required="">
			<input class="text" style="margin-bottom:10px" type="password" asp-for="Password" placeholder="Password" required="">

			<div class="wthree-text">
				<label class="anim">
					<input type="checkbox" class="checkbox" asp-for="RemmemberMe" required="">
					<span>Remmember Me</span>
				</label>
				<div class="clear"> </div>
			</div>
			<input type="submit" value="LOG IN">
		</form>
		<p>Create new account ..!? <a href="SignUp"> Register Now!</a></p>
	</div>
</div>
