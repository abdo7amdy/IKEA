@model LogInVM
@{
    ViewData["Title"] = "LogIn";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}
<div class="main-agileinfo">
	<div class="agileits-top">
		<form asp-action="LogIn" method="post">
			<input class="text" style="margin-bottom:10px" type="email" asp-for="Email" placeholder="Email" required="">
			<input class="text" style="margin-bottom:10px" type="password" asp-for="Password" placeholder="Password" required="">

			<div class="wthree-text">
				<label class="anim">
					<input type="checkbox" class="checkbox" asp-for="RememberMe" required="">
					<span>Remember Me</span>
				</label>
				<p><a asp-action="ForgetPassword"> Forget Password !</a></p>
				<div class="clear"> </div>
			</div>
			<input type="submit" value="LOG IN">
		</form>
		<div asp-validation-summary="All" class="text-danger"></div>
		<p>If you don't have an Account? <a asp-action="SignUp"> Register Now !</a></p>
	</div>
</div>
