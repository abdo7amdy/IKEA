@model EmployeeVM
@inject IDepartmentServices departmentServices

@{
    ViewData["Title"] = "Edit Employee";
    var departments = new SelectList(departmentServices.GetAllDepartments(), nameof(DepartmentDto.Id), nameof(DepartmentDto.Name));

}


<div class="row justify-content-center align-content-center flex-column">
    <h4 class="col-6 my-4">Edit Employee "@Model.Name"</h4>

    <form asp-action="Edit" method="post" class="row col-6">
        <div asp-validation-summary="ModelOnly"></div>
        <input hidden asp-for="ImageName"/>
        <partial name="Partials/_CreateEditPartial" model="@Model" />
        <div class="form-group col-6">
            <label  asp-for="DepartmenId"></label>
            <select asp-for="DepartmenId" asp-items="@departments" class="form-control">
                <option value="@null">Choose ..</option>
            </select>
        </div>
        <div class="mt-4">
            <input type="submit" value="Update" class="btn btn-success" /> ||
            <a asp-action="Index" class="btn btn-secondary">Back To List</a>
        </div>
    </form>
</div>

@section ValidateScript
{
    <partial name="_ValidationScriptsPartial" />
}