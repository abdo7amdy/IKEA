@model EmployeeVM 
@{
    ViewData["Title"] = "Add Employee";
}


<div class="row justify-content-center align-content-center flex-column">
    <h1 class="col-6 my-4">Add Employee</h1>

    <form asp-action="Create" method="post" class="row col-6">
        <div asp-validation-summary="ModelOnly"></div>
        <partial name="Partials/_CreateEditPartial" model="@Model" />
        <div class="mt-4">
            <input type="submit" value="Create" class="btn btn-primary" /> ||
            <a asp-action="Index" class="btn btn-secondary">Back To List</a>
        </div>
    </form>
</div>

@section ValidateScript
{
    <partial name="_ValidationScriptsPartial" />
}