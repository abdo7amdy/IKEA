@model EmployeeVM 
@inject IDepartmentServices departmentServices
@{
    ViewData["Title"] = "Add Employee";
    var departments = new SelectList(await departmentServices.GetAllDepartments(), nameof(DepartmentDto.Id), nameof(DepartmentDto.Name));
}

<div class="row justify-content-center align-content-center flex-column">
    <h1 class="col-6 my-4">Add Employee</h1>

    <form asp-action="Create" method="post" class="row col-6">
        <div asp-validation-summary="ModelOnly"></div>
        <partial name="Partials/_CreateEditPartial" model="@Model" />

        <div class="form-group col-6">
            <label  asp-for="DepartmenId"></label>
            <select asp-for="DepartmenId" asp-items="@departments" class="form-control">
                <option value="@null">Choose ..</option>
            </select>
        </div>
        <div class="mt-4">
            <input type="submit" value="Create" class="btn btn-primary" /> ||
            <a asp-action="Index" class="btn btn-secondary">Back To List</a>
        </div>
    </form>
</div>

@section ValidateScript
{
    <partial name="_ValidationScriptsPartial" />
}